rules_version = '2';

// UTKAST. Ikke produksjonsregler før tests/rules er kjørt og består.
// Se DESIGN-firebase-sikkerhet-og-datamodell.md.
//
// Custom claims (settes bare fra server med Admin SDK):
//   role: 'admin' | 'editor' (fraværende = vanlig bruker)
//   pid:  id til personen i /persons som denne innloggingen tilhører
//
// Kjente begrensninger (kan ikke uttrykkes i regler):
//   - 'slots' (antall plasser på en oppgave) kan ikke håndheves. UI og
//     aktivitetStatus utleder status; ingen regel teller tildelinger.
//   - Rate limiting av meldinger finnes ikke.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- hjelpefunksjoner ----------
    function signedIn() { return request.auth != null; }
    function roleClaim() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin()   { return roleClaim() == 'admin'; }
    function isEditor()  { return roleClaim() == 'admin' || roleClaim() == 'editor'; }
    function myPid()     { return signedIn() ? request.auth.token.get('pid', '') : ''; }
    function hasPid()    { return myPid() != ''; }
    function isSelf(pid) { return hasPid() && myPid() == pid; }

    function memberRef(gid, pid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(pid);
    }
    function isMember(gid) {
      return hasPid() && exists(memberRef(gid, myPid()));
    }
    function isLeader(gid) {
      return isMember(gid)
        && get(memberRef(gid, myPid())).data.role in ['leader', 'deputy'];
    }
    function keysOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }
    function taskGroup(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data.groupId;
    }

    // ---------- standard: alt stengt ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- innhold (offentlig nettsted) ----------
    match /pages/{id} {
      allow read: if isEditor() || resource.data.status == 'published';
      allow create, update: if isEditor()
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isEditor();
    }
    match /news/{id} {
      allow read: if isEditor() || resource.data.status == 'published';
      allow create, update: if isEditor()
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isEditor();
    }

    // ---------- brukere (skrives bare av server) ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ---------- personer ----------
    match /persons/{pid} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSelf(pid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoPath']));

      // e-post og fødselsdato: bare personen selv og admin
      match /private/{doc} {
        allow read, write: if isAdmin() || isSelf(pid);
      }
    }

    // ---------- grupper ----------
    match /groups/{gid} {
      allow read: if isMember(gid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isLeader(gid);

      match /members/{pid} {
        allow read: if isMember(gid) || isAdmin();
        // Bare admin kan gjøre noen til leder eller endre/fjerne en leder.
        allow create: if request.resource.data.pid == pid
          && request.resource.data.role in ['leader', 'deputy', 'member']
          && (isAdmin()
              || (isLeader(gid) && request.resource.data.role in ['deputy', 'member']));
        allow update: if request.resource.data.pid == pid
          && request.resource.data.role in ['leader', 'deputy', 'member']
          && (isAdmin()
              || (isLeader(gid)
                  && resource.data.role != 'leader'
                  && request.resource.data.role in ['deputy', 'member']));
        allow delete: if isAdmin()
          || (isLeader(gid) && resource.data.role != 'leader');
      }

      // Mobilnummer som ledere i gruppen kan se (beslutning A).
      // Personen deler selv nummeret med gruppen; admin kan også skrive.
      match /memberContacts/{pid} {
        allow read: if isAdmin() || isSelf(pid) || isLeader(gid);
        allow create, update: if keysOnly(['pid', 'phone'])
          && request.resource.data.pid == pid
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 20
          && (isAdmin() || (isSelf(pid) && isMember(gid)));
        allow delete: if isAdmin() || isSelf(pid);
      }

      match /messages/{mid} {
        allow read: if isMember(gid) || isAdmin();
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(['authorPid', 'text', 'imagePath', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorPid', 'text', 'createdAt'])
          && request.resource.data.authorPid == myPid()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || request.resource.data.get('imagePath', '') != '')
          && request.resource.data.createdAt == request.time
          && (!('imagePath' in request.resource.data)
              || (request.resource.data.imagePath is string
                  && request.resource.data.imagePath.matches('groups/' + gid + '/chat/.+')));
        allow update: if false;
        allow delete: if isAdmin()
          || isLeader(gid)
          || (isMember(gid) && resource.data.authorPid == myPid());
      }
    }

    // Brukes av "Min side" for å finne egne grupper (collection group query).
    match /{path=**}/members/{pid} {
      allow read: if hasPid() && resource.data.pid == myPid();
    }

    // ---------- samlinger/arrangementer ----------
    // 'public: true' = lesbart for alle (kalender på nettstedet), også uinnlogget.
    // groupId == null = felles for hele menigheten (bare admin skriver).
    match /gatherings/{id} {
      allow read: if resource.data.get('public', false) == true
        || isAdmin()
        || (signedIn()
            && (resource.data.get('groupId', null) == null
                || isMember(resource.data.groupId)));
      allow create: if isAdmin()
        || (request.resource.data.get('groupId', null) != null
            && isLeader(request.resource.data.groupId));
      allow update: if isAdmin()
        || (resource.data.get('groupId', null) != null
            && isLeader(resource.data.groupId)
            && request.resource.data.groupId == resource.data.groupId);
      allow delete: if isAdmin()
        || (resource.data.get('groupId', null) != null
            && isLeader(resource.data.groupId));

      match /attendances/{pid} {
        function gGroup() {
          return get(/databases/$(database)/documents/gatherings/$(id)).data.get('groupId', null);
        }
        allow read: if isSelf(pid) || isAdmin()
          || (gGroup() != null && isLeader(gGroup()));
        allow create, update: if isSelf(pid)
          && keysOnly(['pid', 'status', 'updatedAt'])
          && request.resource.data.pid == pid
          && request.resource.data.status in ['attending', 'declined']
          && (gGroup() == null || isMember(gGroup()));
        allow delete: if isSelf(pid) || isAdmin();
      }
    }

    // ---------- oppgaver ----------
    match /tasks/{id} {
      allow read: if isMember(resource.data.groupId) || isAdmin();
      allow create: if isAdmin() || isLeader(request.resource.data.groupId);
      allow update: if (isAdmin() || isLeader(resource.data.groupId))
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isAdmin() || isLeader(resource.data.groupId);
    }

    // ---------- tildelinger (id = taskId + '_' + pid) ----------
    match /assignments/{aid} {
      allow read: if isMember(resource.data.groupId) || isAdmin();

      allow create: if keysOnly(['taskId', 'groupId', 'pid', 'status', 'updatedAt'])
        && aid == request.resource.data.taskId + '_' + request.resource.data.pid
        && request.resource.data.status in ['pending', 'confirmed', 'declined', 'withdrawn']
        && taskGroup(request.resource.data.taskId) == request.resource.data.groupId
        && (isAdmin()
            || (isSelf(request.resource.data.pid)
                && isMember(request.resource.data.groupId)
                && request.resource.data.status in ['pending', 'confirmed'])
            || isLeader(request.resource.data.groupId));

      allow update: if keysOnly(['taskId', 'groupId', 'pid', 'status', 'updatedAt'])
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.pid == resource.data.pid
        && request.resource.data.status in ['pending', 'confirmed', 'declined', 'withdrawn']
        && (isAdmin()
            || isLeader(resource.data.groupId)
            || (isSelf(resource.data.pid)
                && request.resource.data.status in ['confirmed', 'declined', 'withdrawn']));

      allow delete: if isAdmin() || isLeader(resource.data.groupId);
    }
  }
}
