rules_version = '2';

// UTKAST. Ikke produksjonsregler før tests/rules er kjørt og består.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn()  { return request.auth != null; }
    function roleClaim() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isEditor()  { return roleClaim() == 'admin' || roleClaim() == 'editor'; }
    function myPid()     { return signedIn() ? request.auth.token.get('pid', '') : ''; }
    function isImage(maxBytes) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= maxBytes;
    }
    function isGroupMember(gid) {
      return myPid() != ''
        && firestore.exists(/databases/(default)/documents/groups/$(gid)/members/$(myPid()));
    }

    // Standard: alt stengt
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Bilder til nettstedet: alle leser, redaktør/admin skriver
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor() && isImage(10 * 1024 * 1024);
      allow delete: if isEditor();
    }

    // Bilder i gruppechat: bare medlemmer
    match /groups/{gid}/chat/{file} {
      allow read: if isGroupMember(gid) || roleClaim() == 'admin';
      allow create: if isGroupMember(gid) && isImage(5 * 1024 * 1024);
      allow update: if false;
      allow delete: if roleClaim() == 'admin';
    }

    // Profilbilder: innloggede leser, eieren skriver
    match /profiles/{pid}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && myPid() == pid && isImage(2 * 1024 * 1024);
      allow delete: if signedIn() && (myPid() == pid || roleClaim() == 'admin');
    }
  }
}
